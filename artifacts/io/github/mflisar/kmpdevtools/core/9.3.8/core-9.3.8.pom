  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.mflisar.kmpdevtools</groupId>
  <artifactId>core</artifactId>
  <version>9.3.8</version>
  <name>kmp-devtools</name>
  <description>kmp-devtools - core module - a gradle plugin and plain kotlin dependency that provides core functions for kmp libraries for development tooling</description>
  <url>https://github.com/MFlisar/kmp-devtools</url>
  <inceptionYear>2025</inceptionYear>
  <licenses>
